---
import BaseLayout from './BaseLayout.astro';
import { site } from '../data/site';

const { frontmatter } = Astro.props;
---
<BaseLayout title={`${frontmatter.title} - ${site.name}`} description={frontmatter.description}>
  <article class="mx-auto max-w-3xl">
    <a href="/blog" class="font-semibold text-[var(--accent)]">Back to blog</a>
    <p class="mt-6 text-sm text-[var(--muted)]">{frontmatter.date}</p>
    <h1 class="mt-3 text-4xl font-bold leading-tight">{frontmatter.title}</h1>
    <div class="prose-content mt-8">
      <slot />
    </div>
  </article>
</BaseLayout>
