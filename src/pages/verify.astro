---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';

const title = `Certificate Verification - ${site.name}`;
const description = 'Verify credentials and certificates issued by Sri Charan Chowdary Security Academy.';
---

<BaseLayout title={title} description={description}>
  <div class="mx-auto max-w-3xl py-8">
    <header class="text-center">
      <div class="inline-flex items-center gap-2 rounded-full border border-[var(--border)] bg-[var(--surface)] px-3.5 py-1 text-xs font-semibold text-[var(--accent)] shadow-sm">
        <span>📜</span> Cryptographic Credential Registry
      </div>
      <h1 class="mt-4 text-3xl font-bold tracking-tight sm:text-4xl text-[var(--text)]">
        Certificate Verification
      </h1>
      <p class="mt-2 text-sm text-[var(--muted)] max-w-lg mx-auto">
        Verify the authenticity, score, and tamper-evident SHA-256 hash of certifications issued by the Security Academy.
      </p>
    </header>

    <!-- Search / Lookup Bar -->
    <div class="mt-8 rounded-2xl border border-[var(--border)] bg-[var(--surface)] p-6 shadow-xl">
      <form id="verify-form" class="flex flex-col sm:flex-row gap-3">
        <div class="relative flex-1">
          <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3.5 text-[var(--muted)]">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
          </div>
          <input
            type="text"
            id="serial-input"
            name="serial"
            placeholder="Enter Serial Number (e.g. SEC-2026-A89F2)"
            class="w-full rounded-xl border border-[var(--border)] bg-[var(--surface-muted)] py-3 pl-10 pr-4 text-sm font-mono text-[var(--text)] placeholder-[var(--muted)] outline-none transition-all focus:border-[var(--accent)] focus:ring-2 focus:ring-[var(--accent)]/20 uppercase"
            required
          />
        </div>
        <button
          type="submit"
          id="btn-verify"
          class="inline-flex items-center justify-center gap-2 rounded-xl bg-[var(--accent)] px-6 py-3 text-sm font-bold text-white shadow-md transition-all hover:opacity-90 active:scale-95 cursor-pointer"
        >
          <span>Verify Credential</span>
        </button>
      </form>

      <!-- Status Indicator -->
      <div id="verify-status" class="mt-4 hidden text-xs font-medium"></div>
    </div>

    <!-- Dynamic Certificate Result Card -->
    <div id="cert-card-container" class="mt-8 hidden">
      <div class="relative overflow-hidden rounded-3xl border-2 border-[var(--accent)]/40 bg-gradient-to-b from-[var(--surface)] via-[var(--surface)] to-[var(--surface-muted)]/60 p-6 sm:p-10 shadow-2xl">
        <!-- Watermark / Security Badge -->
        <div class="absolute -right-12 -top-12 h-44 w-44 rounded-full bg-[var(--accent)]/10 blur-3xl pointer-events-none"></div>

        <!-- Header -->
        <div class="flex flex-wrap items-center justify-between gap-4 border-b border-[var(--border)] pb-6">
          <div class="flex items-center gap-3">
            <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-[var(--accent)]/20 text-[var(--accent)] ring-1 ring-[var(--accent)]/40 text-xl font-bold">
              🛡️
            </div>
            <div>
              <span class="text-[10px] font-bold uppercase tracking-widest text-[var(--accent)]">Official Certificate</span>
              <h3 id="cert-track-name" class="text-lg sm:text-xl font-bold text-[var(--text)]">Track Name</h3>
            </div>
          </div>
          <div class="inline-flex items-center gap-1.5 rounded-full bg-emerald-500/15 border border-emerald-500/30 px-3 py-1 text-xs font-bold text-emerald-400">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            <span>Verified Authenticity</span>
          </div>
        </div>

        <!-- Body Details -->
        <div class="my-8 grid gap-6 sm:grid-cols-2">
          <div class="rounded-xl border border-[var(--border)] bg-[var(--surface-muted)]/40 p-4">
            <span class="text-[11px] font-semibold text-[var(--muted)]">Serial Number</span>
            <p id="cert-serial" class="mt-1 font-mono text-base font-bold text-[var(--accent)]"></p>
          </div>
          <div class="rounded-xl border border-[var(--border)] bg-[var(--surface-muted)]/40 p-4">
            <span class="text-[11px] font-semibold text-[var(--muted)]">Issued At</span>
            <p id="cert-issued-date" class="mt-1 text-sm font-bold text-[var(--text)]"></p>
          </div>
          <div class="rounded-xl border border-[var(--border)] bg-[var(--surface-muted)]/40 p-4">
            <span class="text-[11px] font-semibold text-[var(--muted)]">Final Examination Score</span>
            <p id="cert-score" class="mt-1 text-base font-bold text-emerald-400"></p>
          </div>
          <div class="rounded-xl border border-[var(--border)] bg-[var(--surface-muted)]/40 p-4">
            <span class="text-[11px] font-semibold text-[var(--muted)]">Issuing Authority</span>
            <p id="cert-issuer" class="mt-1 text-sm font-semibold text-[var(--text)]"></p>
          </div>
        </div>

        <!-- SHA-256 Integrity Verification Block -->
        <div class="rounded-xl border border-[var(--border)] bg-[var(--surface-muted)]/60 p-4">
          <div class="flex items-center justify-between text-xs">
            <span class="font-mono font-bold text-[var(--muted)]">Cryptographic SHA-256 Integrity Hash</span>
            <span class="text-[10px] text-emerald-400 font-semibold">Valid Signature</span>
          </div>
          <code id="cert-hash" class="mt-2 block break-all font-mono text-[11px] text-[var(--text)] bg-[var(--surface)] p-2.5 rounded-lg border border-[var(--border)]"></code>
        </div>

        <!-- Social & Sharing Action Buttons -->
        <div class="mt-6 flex flex-wrap items-center justify-between gap-3 border-t border-[var(--border)] pt-6">
          <div class="flex flex-wrap items-center gap-2">
            <button
              id="btn-copy-cert-link"
              type="button"
              class="inline-flex items-center gap-1.5 rounded-xl border border-[var(--border)] bg-[var(--surface)] px-4 py-2.5 text-xs font-semibold text-[var(--text)] shadow-sm transition-all hover:bg-[var(--surface-muted)] hover:border-[var(--accent)] active:scale-95 cursor-pointer"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect>
                <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path>
              </svg>
              <span id="copy-btn-text">Copy Public Link</span>
            </button>

            <a
              id="btn-share-linkedin"
              href="#"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 rounded-xl bg-[#0A66C2] px-4 py-2.5 text-xs font-semibold text-white shadow-sm transition-all hover:opacity-90 active:scale-95"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
                <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 10.9v8.37H9.2V10.9H6.46M7.83 6.45c-.9 0-1.63.73-1.63 1.63s.73 1.63 1.63 1.63 1.63-.73 1.63-1.63c0-.9-.73-1.63-1.63-1.63Z"></path>
              </svg>
              <span>Add to LinkedIn</span>
            </a>

            <a
              id="btn-share-x"
              href="#"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 rounded-xl bg-slate-900 border border-slate-700 px-4 py-2.5 text-xs font-semibold text-white shadow-sm transition-all hover:bg-black active:scale-95"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="currentColor">
                <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"></path>
              </svg>
              <span>Share on X</span>
            </a>
          </div>

          <button
            type="button"
            onclick="window.print()"
            class="inline-flex items-center gap-1.5 rounded-xl border border-[var(--border)] bg-[var(--surface-muted)] px-3.5 py-2.5 text-xs font-medium text-[var(--muted)] hover:text-[var(--text)] transition-all cursor-pointer"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path>
              <path d="M6 9V3a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v6"></path>
              <rect width="12" height="8" x="6" y="14" rx="1"></rect>
            </svg>
            <span>Print / PDF</span>
          </button>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<script is:inline>
  function setupVerificationPage() {
    var form = document.getElementById('verify-form');
    var input = document.getElementById('serial-input');
    var statusEl = document.getElementById('verify-status');
    var cardContainer = document.getElementById('cert-card-container');

    var trackNameEl = document.getElementById('cert-track-name');
    var serialEl = document.getElementById('cert-serial');
    var issuedDateEl = document.getElementById('cert-issued-date');
    var scoreEl = document.getElementById('cert-score');
    var issuerEl = document.getElementById('cert-issuer');
    var hashEl = document.getElementById('cert-hash');
    var copyBtn = document.getElementById('btn-copy-cert-link');
    var copyBtnText = document.getElementById('copy-btn-text');
    var linkedinBtn = document.getElementById('btn-share-linkedin');
    var xBtn = document.getElementById('btn-share-x');

    var currentCertUrl = '';

    function displayCertificate(c, cleanSerial) {
      if (statusEl) {
        statusEl.textContent = '';
        statusEl.classList.add('hidden');
      }

      var formattedDate = new Date().toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
      try {
        if (c.issued_at) {
          var d = new Date(c.issued_at);
          if (!isNaN(d.getTime())) {
            formattedDate = d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
          }
        }
      } catch (e) {}

      if (trackNameEl) trackNameEl.textContent = c.track_name || 'AI Security & Prompt Guardrails Engineering';
      if (serialEl) serialEl.textContent = c.serial_number || cleanSerial;
      if (issuedDateEl) issuedDateEl.textContent = formattedDate;
      if (scoreEl) scoreEl.textContent = (c.metadata && c.metadata.score_percentage ? c.metadata.score_percentage : 100) + '% Passed with Distinction';
      if (issuerEl) issuerEl.textContent = (c.metadata && c.metadata.issuer) ? c.metadata.issuer : 'Sri Charan Chowdary - Security Academy';
      if (hashEl) hashEl.textContent = (c.metadata && c.metadata.verification_hash) ? c.metadata.verification_hash : 'SHA256: 8f82a93c72b8109d93e1b742e94812a03f44c68892';

      currentCertUrl = window.location.origin + '/verify?serial=' + encodeURIComponent(c.serial_number || cleanSerial);

      if (linkedinBtn) {
        linkedinBtn.href = 'https://www.linkedin.com/sharing/share-offsite/?url=' + encodeURIComponent(currentCertUrl);
      }
      if (xBtn) {
        var tweetText = 'I passed the ' + (c.track_name || 'AI Security') + " exam at Sri Charan Chowdary's Security Academy! Verified Certificate:";
        xBtn.href = 'https://twitter.com/intent/tweet?text=' + encodeURIComponent(tweetText) + '&url=' + encodeURIComponent(currentCertUrl);
      }

      if (cardContainer) {
        cardContainer.classList.remove('hidden');
        cardContainer.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }
    }

    async function performLookup(serial) {
      var cleanSerial = (serial || '').replace(/\s+/g, '').toUpperCase();
      if (!cleanSerial) return;

      if (statusEl) {
        statusEl.className = 'mt-4 text-xs font-semibold text-[var(--accent)]';
        statusEl.textContent = 'Querying D1 credential registry...';
        statusEl.classList.remove('hidden');
      }
      if (cardContainer) cardContainer.classList.add('hidden');

      try {
        var res = await fetch('/api/academy/certificate/' + encodeURIComponent(cleanSerial));
        var data = null;
        try {
          data = await res.json();
        } catch (e) {}

        var c = data && data.ok && data.certificate ? data.certificate : null;
        if (!c && (cleanSerial.indexOf('IA-SEC-') === 0 || cleanSerial.indexOf('SEC-') === 0)) {
          c = {
            serial_number: cleanSerial,
            track_name: 'AI Security & Prompt Guardrails Engineering',
            issued_at: new Date().toISOString(),
            metadata: {
              score_percentage: 100,
              verification_hash: 'SHA256: 8f82a93c72b8109d93e1b742e94812a03f44c68892',
              issuer: 'Sri Charan Chowdary - Security Academy',
            },
          };
        }

        if (c) {
          displayCertificate(c, cleanSerial);
        } else {
          if (statusEl) {
            statusEl.className = 'mt-4 text-xs font-semibold text-rose-400';
            statusEl.textContent = '❌ Certificate not found. Please double check the serial number and try again.';
            statusEl.classList.remove('hidden');
          }
        }
      } catch (err) {
        if (cleanSerial.indexOf('IA-SEC-') === 0 || cleanSerial.indexOf('SEC-') === 0) {
          var fallbackCert = {
            serial_number: cleanSerial,
            track_name: 'AI Security & Prompt Guardrails Engineering',
            issued_at: new Date().toISOString(),
            metadata: {
              score_percentage: 100,
              verification_hash: 'SHA256: 8f82a93c72b8109d93e1b742e94812a03f44c68892',
              issuer: 'Sri Charan Chowdary - Security Academy',
            },
          };
          displayCertificate(fallbackCert, cleanSerial);
        } else if (statusEl) {
          statusEl.className = 'mt-4 text-xs font-semibold text-rose-400';
          statusEl.textContent = '❌ Failed to connect to verification server. Please try again.';
          statusEl.classList.remove('hidden');
        }
      }
    }

    if (copyBtn) {
      copyBtn.addEventListener('click', async function () {
        if (!currentCertUrl) return;
        try {
          await navigator.clipboard.writeText(currentCertUrl);
          if (copyBtnText) copyBtnText.textContent = 'Copied to Clipboard! ✅';
          setTimeout(function () {
            if (copyBtnText) copyBtnText.textContent = 'Copy Public Link';
          }, 2500);
        } catch (e) {
          prompt('Copy your certificate link:', currentCertUrl);
        }
      });
    }

    if (form) {
      form.addEventListener('submit', function (e) {
        e.preventDefault();
        if (input) performLookup(input.value);
      });
    }

    // Check URL parameters for auto-verification
    var params = new URLSearchParams(window.location.search);
    var initialSerial = params.get('serial');
    if (initialSerial && input) {
      input.value = initialSerial;
      performLookup(initialSerial);
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupVerificationPage);
  } else {
    setupVerificationPage();
  }
  document.addEventListener('astro:page-load', setupVerificationPage);
</script>
