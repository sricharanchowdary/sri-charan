---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site } from '../../data/site';
import { getPublicExamQuestions } from '../../lib/exam-engine';

const title = `AI Security Certification Exam - ${site.name}`;
const description = 'Official certification assessment for AI AppSec, prompt guardrails, and secure LLM architecture.';

const questions = getPublicExamQuestions();
---

<BaseLayout title={title} description={description}>
  <div class="mx-auto max-w-3xl py-8">
    <header class="border-b border-[var(--border)] pb-6">
      <div class="flex flex-wrap items-center justify-between gap-4">
        <div>
          <div class="inline-flex items-center gap-2 rounded-full border border-[var(--border)] bg-[var(--surface)] px-3 py-1 text-xs font-semibold text-[var(--accent)]">
            <span>🛡️</span> Professional Assessment
          </div>
          <h1 class="mt-3 text-3xl font-bold tracking-tight text-[var(--text)] sm:text-4xl">
            AI Security Certification Examination
          </h1>
          <p class="mt-2 text-sm text-[var(--muted)]">
            Passing threshold: <strong class="text-[var(--text)]">80%</strong>. Questions are graded server-side against secure question banks.
          </p>
        </div>

        <!-- Candidate Card / GitHub Login -->
        {Astro.locals.user ? (
          <div class="flex items-center gap-3 rounded-2xl border border-[var(--border)] bg-[var(--surface)] p-3 shadow-md">
            <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-[var(--accent)]/15 text-[var(--accent)] font-bold">
              👤
            </div>
            <div class="text-xs">
              <span class="text-[10px] uppercase font-bold text-[var(--muted)]">Verified Candidate</span>
              <p class="font-bold text-[var(--text)]">{Astro.locals.user.name}</p>
              <p class="text-[11px] text-[var(--muted)] font-mono">{Astro.locals.user.email}</p>
            </div>
          </div>
        ) : (
          <div class="flex items-center gap-3 rounded-2xl border border-[var(--border)] bg-[var(--surface)] p-3 shadow-md">
            <a
              href="/api/auth/github/login?redirect=/academy/exam"
              class="inline-flex items-center gap-2 rounded-xl bg-[var(--surface-muted)] px-3 py-2 text-xs font-bold text-[var(--text)] hover:border-[var(--accent)] border border-[var(--border)] transition-all"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
              </svg>
              <span>Sign in with GitHub</span>
            </a>
          </div>
        )}
      </div>
    </header>

    <!-- Interactive Examination Form -->
    <form id="exam-form" class="mt-8 space-y-8">
      {questions.map((q, qIndex) => (
        <div class="question-card rounded-2xl border border-[var(--border)] bg-[var(--surface)] p-6 shadow-md transition-all" data-question-id={q.id}>
          <div class="flex items-start justify-between gap-3">
            <div class="flex items-start gap-3">
              <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-lg bg-[var(--accent)]/15 text-xs font-bold text-[var(--accent)]">
                {qIndex + 1}
              </span>
              <h3 class="text-base font-bold leading-snug text-[var(--text)]">
                {q.question}
              </h3>
            </div>
            <span class="rounded-md bg-[var(--surface-muted)] px-2 py-0.5 text-[10px] font-mono font-semibold text-[var(--muted)]">
              {q.topic}
            </span>
          </div>

          <div class="mt-4 space-y-2.5">
            {q.options.map((opt, optIndex) => (
              <label class="flex items-center gap-3 rounded-xl border border-[var(--border)] bg-[var(--surface-muted)]/50 p-3.5 text-xs sm:text-sm text-[var(--text)] hover:border-[var(--accent)]/60 cursor-pointer transition-all">
                <input
                  type="radio"
                  name={`q-${q.id}`}
                  value={optIndex}
                  required
                  class="h-4 w-4 accent-[var(--accent)] cursor-pointer"
                />
                <span>{opt}</span>
              </label>
            ))}
          </div>

          <!-- Feedback Box (Shown after submission) -->
          <div class="feedback-box mt-4 hidden rounded-xl p-3.5 text-xs"></div>
        </div>
      ))}

      <!-- Submission Bar -->
      <div class="sticky bottom-6 flex flex-wrap items-center justify-between gap-4 rounded-2xl border border-[var(--border)] bg-[var(--surface)]/95 p-4 shadow-2xl backdrop-blur-md">
        <div class="text-xs text-[var(--muted)]">
          Ensure all questions are answered before submitting.
        </div>
        <button
          type="submit"
          id="btn-submit-exam"
          class="inline-flex items-center justify-center gap-2 rounded-xl bg-[var(--accent)] px-8 py-3 text-sm font-bold text-white shadow-lg transition-all hover:opacity-90 active:scale-95 cursor-pointer"
        >
          <span>Submit for Certification</span>
          <span>&rarr;</span>
        </button>
      </div>
    </form>

    <!-- Certificate Success Modal Card -->
    <div id="result-modal" class="mt-8 hidden rounded-3xl border-2 border-emerald-500/40 bg-[var(--surface)] p-8 shadow-2xl">
      <div class="text-center">
        <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-2xl bg-emerald-500/20 text-3xl">
          🏆
        </div>
        <h2 class="mt-4 text-2xl font-bold text-[var(--text)]">Congratulations! You Passed</h2>
        <p id="score-text" class="mt-1 text-sm font-semibold text-emerald-400"></p>
        <p class="mt-2 text-xs text-[var(--muted)] max-w-md mx-auto">
          Your credential has been recorded in the Cloudflare D1 registry and issued a verifiable cryptographic serial.
        </p>

        <div class="mt-6 flex flex-wrap items-center justify-center gap-4">
          <a
            id="view-cert-link"
            href="/verify"
            class="inline-flex items-center justify-center gap-2 rounded-xl bg-emerald-600 px-6 py-3 text-sm font-bold text-white shadow-md hover:bg-emerald-500 transition-all active:scale-95"
          >
            <span>📜</span>
            <span>View & Share Certificate</span>
          </a>
          <a
            href="/academy"
            class="inline-flex items-center justify-center rounded-xl border border-[var(--border)] bg-[var(--surface-muted)] px-6 py-3 text-sm font-bold text-[var(--text)] hover:bg-[var(--surface)]"
          >
            Return to Academy
          </a>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  function setupExam() {
    const form = document.getElementById('exam-form') as HTMLFormElement | null;
    if (!form) return;

    const resultModal = document.getElementById('result-modal');
    const scoreText = document.getElementById('score-text');
    const viewCertLink = document.getElementById('view-cert-link') as HTMLAnchorElement | null;
    const submitBtn = document.getElementById('btn-submit-exam') as HTMLButtonElement | null;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      const questionCards = form.querySelectorAll('.question-card');
      const answers: Record<string, number> = {};

      questionCards.forEach((card) => {
        const qId = (card as HTMLElement).dataset.questionId;
        if (!qId) return;
        const selectedRadio = form.querySelector(`input[name="q-${qId}"]:checked`) as HTMLInputElement | null;
        if (selectedRadio) {
          answers[qId] = parseInt(selectedRadio.value, 10);
        }
      });

      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = 'Grading on Server...';
      }

      try {
        const res = await fetch('/api/exam/submit', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ answers }),
        });

        const rawText = await res.text();
        let data: any;
        try {
          data = JSON.parse(rawText);
        } catch {
          throw new Error(`Server returned unexpected response (HTTP ${res.status}): ${rawText.substring(0, 100)}`);
        }

        if (data.ok && data.results) {
          // Render individual question feedback
          data.results.forEach((r: any) => {
            const card = form.querySelector(`[data-question-id="${r.id}"]`);
            if (card) {
              const feedbackBox = card.querySelector('.feedback-box') as HTMLElement | null;
              if (feedbackBox) {
                if (r.isCorrect) {
                  feedbackBox.className = 'feedback-box mt-4 rounded-xl p-3.5 text-xs bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 font-medium';
                  feedbackBox.innerHTML = `<strong>✅ Correct:</strong> ${r.explanation}`;
                  feedbackBox.classList.remove('hidden');
                } else {
                  feedbackBox.className = 'feedback-box mt-4 rounded-xl p-3.5 text-xs bg-rose-500/10 border border-rose-500/30 text-rose-400 font-medium';
                  feedbackBox.innerHTML = `<strong>❌ Incorrect:</strong> ${r.explanation}`;
                  feedbackBox.classList.remove('hidden');
                }
              }
            }
          });

          if (data.passed) {
            if (scoreText) scoreText.textContent = `Final Score: ${data.score}% (${data.correctCount}/${data.totalCount})`;
            if (viewCertLink) viewCertLink.href = data.shareableUrl || `/verify?serial=${encodeURIComponent(data.serialNumber)}`;
            if (resultModal) {
              resultModal.classList.remove('hidden');
              resultModal.scrollIntoView({ behavior: 'smooth' });
            }
            if (submitBtn) submitBtn.textContent = 'Certification Earned! 🏆';
          } else {
            alert(`You scored ${data.score}% (${data.correctCount}/${data.totalCount}). A score of ${data.requiredScore}% is required to pass. Review the explanations below and try again.`);
            if (submitBtn) {
              submitBtn.disabled = false;
              submitBtn.textContent = 'Retry Submission';
            }
          }
        } else {
          alert('Failed to submit exam: ' + (data.error || 'Server error'));
          if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.textContent = 'Submit for Certification';
          }
        }
      } catch (err: any) {
        alert('Error submitting exam: ' + err.message);
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = 'Submit for Certification';
        }
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupExam);
  } else {
    setupExam();
  }
  document.addEventListener('astro:page-load', setupExam);
</script>
