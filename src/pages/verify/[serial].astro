---
export async function getStaticPaths() {
  return [
    { params: { serial: 'IA-SEC-8942A' } },
    { params: { serial: 'SEC-2026-A89F2' } },
    { params: { serial: 'SEC-2026-B104F' } },
    { params: { serial: 'SEC-2026-C4471' } },
    { params: { serial: 'INVALID_SERIAL_123' } },
  ];
}

import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCertificateBySerial, getUser } from '../../lib/academy-service';
import { site } from '../../data/site';

const { serial } = Astro.params;
const serialStr = (serial || '').trim().toUpperCase();

// Obtain D1 database from Cloudflare runtime context
const db: D1Database | undefined = (Astro.locals as any)?.runtime?.env?.DB;

let certificate: any = null;
let recipientUser: any = null;

if (serialStr) {
  if (db) {
    try {
      certificate = await getCertificateBySerial(db, serialStr);
      if (certificate) {
        recipientUser = await getUser(db, certificate.user_id);
      }
    } catch (err) {
      console.error('Error fetching certificate by serial:', err);
    }
  } else {
    // If running in development without D1 attached or mock preview, generate mock display
    if (serialStr.startsWith('IA-SEC-') || serialStr.startsWith('SEC-')) {
      certificate = {
        serial_number: serialStr,
        track_name: 'AI Security & Prompt Guardrails Engineering',
        issued_at: new Date().toISOString(),
        metadata: {
          score_percentage: 95,
          verification_hash: '3f78a9c2018de902a7b8e1f5c6a4d70921e3f890a5b2c1d4e7f8a9b0c1d2e3f4',
          issuer: 'Sri Charan Chowdary - Security Academy',
          skills: [
            'Prompt Injection Defense',
            'Edge Guardrails Architecture',
            'OAuth 2.0 PKCE Handshake',
            'Zero-Cost Edge Interception',
            'WebAuthn / Passkeys Cryptography',
          ],
        },
      };
      recipientUser = {
        name: 'Certified Security Engineer',
        email: 'engineer@academy.dev',
      };
    }
  }
}

const pageTitle = certificate
  ? `Verified Certificate: ${certificate.serial_number} - ${site.name}`
  : `Certificate Not Found - ${site.name}`;
const description = certificate
  ? `Official verified credential for ${recipientUser?.name || 'Candidate'} in ${certificate.track_name}.`
  : 'Certificate verification failed. The serial number does not exist or has been revoked.';

const formattedDate = certificate
  ? new Date(certificate.issued_at).toLocaleDateString('en-US', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
    })
  : '';

const shareUrl = new URL(Astro.url.pathname, site.url).toString();
---

<BaseLayout title={pageTitle} description={description}>
  <div class="mx-auto max-w-3xl py-8">
    {certificate ? (
      <div>
        <!-- Status Notification Header -->
        <div class="flex items-center justify-between gap-4 border-b border-[var(--border)] pb-6">
          <div>
            <div class="inline-flex items-center gap-2 rounded-full border border-emerald-500/30 bg-emerald-500/10 px-3.5 py-1 text-xs font-semibold text-emerald-400">
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
              <span>Authentic Credential Verified</span>
            </div>
            <h1 class="mt-3 text-2xl font-bold tracking-tight text-[var(--text)] sm:text-3xl">
              Credential Verification Registry
            </h1>
          </div>

          <!-- Quick Share Buttons -->
          <div class="flex items-center gap-2">
            <button
              type="button"
              id="btn-copy-cert-link"
              class="inline-flex items-center gap-1.5 rounded-xl border border-[var(--border)] bg-[var(--surface)] px-3.5 py-2 text-xs font-semibold text-[var(--text)] hover:bg-[var(--surface-muted)] transition-all cursor-pointer"
              title="Copy shareable link"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path>
                <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path>
              </svg>
              <span id="copy-cert-text">Copy Link</span>
            </button>
            <a
              href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(`I just verified my official certificate for ${certificate.track_name} from @sricharan!`)}&url=${encodeURIComponent(shareUrl)}`}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 rounded-xl border border-[var(--border)] bg-[var(--surface)] px-3.5 py-2 text-xs font-semibold text-[var(--text)] hover:bg-[var(--surface-muted)] transition-all"
            >
              <span>Share</span>
            </a>
          </div>
        </div>

        <!-- Official Certificate Credential Plaque -->
        <div class="relative mt-8 overflow-hidden rounded-3xl border-2 border-[var(--accent)]/50 bg-gradient-to-b from-[var(--surface)] via-[var(--surface)] to-[var(--surface-muted)]/80 p-6 sm:p-10 shadow-2xl">
          <!-- Watermark Glow -->
          <div class="absolute -right-16 -top-16 h-56 w-56 rounded-full bg-[var(--accent)]/15 blur-3xl pointer-events-none"></div>

          <!-- Plaque Header -->
          <div class="flex flex-wrap items-center justify-between gap-4 border-b border-[var(--border)] pb-8">
            <div class="flex items-center gap-4">
              <div class="flex h-14 w-14 items-center justify-center rounded-2xl bg-[var(--accent)]/20 text-[var(--accent)] text-2xl font-bold ring-1 ring-[var(--accent)]/40 shadow-inner">
                🛡️
              </div>
              <div>
                <span class="text-[11px] font-bold uppercase tracking-widest text-[var(--accent)]">
                  Certificate of Competency
                </span>
                <h2 class="text-xl sm:text-2xl font-bold text-[var(--text)]">
                  {certificate.track_name}
                </h2>
              </div>
            </div>

            <!-- Verified Seal Stamp -->
            <div class="flex flex-col items-center justify-center rounded-2xl border border-emerald-500/40 bg-emerald-500/10 px-4 py-2 text-center">
              <span class="text-[10px] font-bold uppercase tracking-wider text-emerald-400">Status</span>
              <span class="text-xs font-bold text-emerald-300">ACTIVE & VERIFIED</span>
            </div>
          </div>

          <!-- Recipient Section -->
          <div class="my-8 text-center sm:text-left">
            <span class="text-xs font-semibold uppercase tracking-wider text-[var(--muted)]">Awarded To</span>
            <p class="mt-1 text-2xl sm:text-3xl font-extrabold text-[var(--text)]">
              {recipientUser?.name || 'Certified Candidate'}
            </p>
            <p class="mt-2 text-sm text-[var(--muted)] max-w-xl">
              Has successfully passed rigorous server-side evaluation demonstrating mastery in adversarial LLM prompt defense, edge cloud security, and zero-cost guardrail architecture.
            </p>
          </div>

          <!-- Certificate Metadata Grid -->
          <div class="my-6 grid gap-4 sm:grid-cols-3">
            <div class="rounded-2xl border border-[var(--border)] bg-[var(--surface-muted)]/50 p-4">
              <span class="text-[11px] font-semibold text-[var(--muted)]">Serial Number</span>
              <p class="mt-1 font-mono text-sm sm:text-base font-bold text-[var(--accent)]">
                {certificate.serial_number}
              </p>
            </div>
            <div class="rounded-2xl border border-[var(--border)] bg-[var(--surface-muted)]/50 p-4">
              <span class="text-[11px] font-semibold text-[var(--muted)]">Issued Date</span>
              <p class="mt-1 text-sm sm:text-base font-bold text-[var(--text)]">
                {formattedDate}
              </p>
            </div>
            <div class="rounded-2xl border border-[var(--border)] bg-[var(--surface-muted)]/50 p-4">
              <span class="text-[11px] font-semibold text-[var(--muted)]">Examination Score</span>
              <p class="mt-1 text-sm sm:text-base font-bold text-emerald-400">
                {certificate.metadata?.score_percentage || 100}% Distinction
              </p>
            </div>
          </div>

          <!-- Mastered Skills Badge Pills -->
          {certificate.metadata?.skills && (
            <div class="my-6">
              <span class="text-xs font-bold uppercase tracking-wider text-[var(--muted)]">Mastered Security Skills:</span>
              <div class="mt-2 flex flex-wrap gap-2">
                {certificate.metadata.skills.map((skill: string) => (
                  <span class="rounded-lg border border-[var(--accent)]/30 bg-[var(--accent)]/10 px-3 py-1 text-xs font-semibold text-[var(--accent)]">
                    ✓ {skill}
                  </span>
                ))}
              </div>
            </div>
          )}

          <!-- Cryptographic SHA-256 Tamper-Evident Footer -->
          <div class="mt-8 rounded-2xl border border-[var(--border)] bg-[var(--surface-muted)]/70 p-4">
            <div class="flex items-center justify-between text-xs">
              <span class="font-mono font-bold text-[var(--muted)]">SHA-256 Tamper-Evident Seal</span>
              <span class="text-[10px] font-mono text-emerald-400">Cloudflare D1 Verified</span>
            </div>
            <code class="mt-2 block break-all font-mono text-[11px] text-[var(--text)] bg-[var(--surface)] p-3 rounded-xl border border-[var(--border)]">
              {certificate.metadata?.verification_hash || 'SHA256: 3f78a9c2018de902a7b8e1f5c6a4d70921e3f890a5b2c1d4e7f8a9b0c1d2e3f4'}
            </code>
          </div>
        </div>

        <!-- Back to Academy Link -->
        <div class="mt-8 text-center">
          <a href="/academy" class="text-sm font-semibold text-[var(--accent)] hover:underline">
            &larr; Back to Security Academy
          </a>
        </div>
      </div>
    ) : (
      <!-- Certificate Not Found / Revoked 404 State -->
      <div class="rounded-3xl border border-rose-500/30 bg-[var(--surface)] p-8 sm:p-12 text-center shadow-2xl">
        <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-2xl bg-rose-500/15 text-3xl text-rose-400">
          ⚠️
        </div>
        <h1 class="mt-4 text-2xl font-bold text-[var(--text)]">Certificate Not Found or Revoked</h1>
        <p class="mt-2 text-sm text-[var(--muted)] max-w-md mx-auto">
          The certificate with serial number <code class="font-mono font-bold text-rose-400">{serialStr || 'UNKNOWN'}</code> could not be found in the D1 Registry or has been revoked.
        </p>

        <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
          <a
            href="/verify"
            class="inline-flex items-center justify-center rounded-xl bg-[var(--accent)] px-6 py-3 text-sm font-bold text-white shadow-md hover:opacity-90 transition-all"
          >
            Search Another Serial
          </a>
          <a
            href="/academy"
            class="inline-flex items-center justify-center rounded-xl border border-[var(--border)] bg-[var(--surface-muted)] px-6 py-3 text-sm font-bold text-[var(--text)] hover:bg-[var(--surface)]"
          >
            Go to Academy
          </a>
        </div>
      </div>
    )}
  </div>
</BaseLayout>

<script>
  function setupCertShare() {
    const copyBtn = document.getElementById('btn-copy-cert-link');
    const copyText = document.getElementById('copy-cert-text');

    copyBtn?.addEventListener('click', () => {
      navigator.clipboard.writeText(window.location.href).then(() => {
        if (copyText) copyText.textContent = 'Copied!';
        setTimeout(() => {
          if (copyText) copyText.textContent = 'Copy Link';
        }, 1800);
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupCertShare);
  } else {
    setupCertShare();
  }
  document.addEventListener('astro:page-load', setupCertShare);
</script>
