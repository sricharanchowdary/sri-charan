{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "sricharanchowdary",
	"compatibility_date": "2026-06-02",
	"observability": {
		"enabled": true
	},
	"assets": {
		"directory": "my-portfolio"
	},
