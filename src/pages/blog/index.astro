---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { posts, site } from '../../data/site';
---
<BaseLayout title={`Blog - ${site.name}`} description="Writing by Sri Charan about machine learning, web projects, and shipping software.">
  <section>
    <h1 class="text-4xl font-bold">Blog</h1>
    <p class="mt-4 max-w-2xl text-lg leading-8 text-[var(--muted)]">
      Short posts about what I am learning while building AI and web projects.
    </p>
  </section>

  <section class="mt-10 grid gap-5 md:grid-cols-2">
    {posts.map((post) => (
      <article class="rounded-lg border border-[var(--border)] bg-[var(--surface)] p-6">
        <p class="text-sm text-[var(--muted)]">{post.date}</p>
        <h2 class="mt-3 text-2xl font-bold">{post.title}</h2>
        <p class="mt-3 leading-7 text-[var(--muted)]">{post.description}</p>
        <a href={`/blog/${post.slug}`} class="mt-5 inline-block font-semibold text-[var(--accent)]">Read post</a>
      </article>
    ))}
  </section>
</BaseLayout>
